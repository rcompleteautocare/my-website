# Template for .env.local — copy to .env.local and fill in real values.
# Never commit .env.local.

INTERNAL_KEY=replace-me

# Scheduling: public Formspree form ID (the short ID after /f/ in its endpoint).
NEXT_PUBLIC_FORMSPREE_FORM_ID=replace-me
# Add https://www.rcompleteautocare.com/api/webhooks/formspree as a Formspree webhook.
FORMSPREE_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Set to "true" to enable Tekmetric writes from inbound webhook
TEKMETRIC_ENABLED=false

TEKMETRIC_API_KEY=replace-me
TEKMETRIC_SHOP_ID=replace-me
TEKMETRIC_BASE_URL=replace-me

# --- Google rating drift check (weekly Vercel cron -> /api/rating-drift) ---
# Google Places API (New) key, restricted to Places API. Server-side only.
PLACES_API_KEY=replace-me
# Optional: overrides the PLACE_ID constant in lib/place.js if set.
# PLACES_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret protecting the cron route. Set the SAME value in Vercel's
# project env so cron requests are authorized. Leave unset to skip the check.
CRON_SECRET=replace-me

# Drift alert webhook (e.g. Zapier/Make catch hook). If unset, drift is logged
# (visible in Vercel cron logs) but not pushed anywhere.
DRIFT_WEBHOOK_URL=replace-me

# --- Google Search Console sitemap submission ---
# Search Console property. Use the domain property when possible.
SITE_URL=sc-domain:rcompleteautocare.com
# Sitemap path or full URL. Defaults to /sitemap.xml when omitted.
SITEMAP_PATH=/sitemap.xml
# Full Desktop OAuth client secret JSON for Search Console API auth.
# Keep the real value only in local/Vercel environment configuration.
GOOGLE_CLIENT_SECRET_JSON='{"installed":{"client_id":"replace-me","client_secret":"replace-me","redirect_uris":["http://localhost"]}}'
# OAuth2 token cache path. This file is ignored by git.
OAUTH2_TOKEN_PATH=.searchconsole-token.json

# --- Google Ads & Analytics tracking ---
# Base Google Ads tag id (gtag.js). Set in Vercel for Production + Preview.
NEXT_PUBLIC_ADS_TAG_ID=AW-18068510962
# Conversion label for the "Click to call" action (phone-link clicks). Combined
# with NEXT_PUBLIC_ADS_TAG_ID as `send_to: <tagId>/<label>`. NEXT_PUBLIC_ vars
# are inlined at BUILD time, so set this in Vercel (Production + Preview) and
# redeploy with build cache OFF before verifying.
NEXT_PUBLIC_ADS_PHONE_CONVERSION_LABEL=DSu9CKnb27wcEPKx3qdD
# Conversion label for the contact-form lead action, fired only after Formspree
# accepts the request. Create the conversion action in Google Ads and paste its
# label here. While empty, the form still sends the generate_lead event but no
# Ads conversion (leave it empty rather than using a placeholder value).
NEXT_PUBLIC_ADS_CONTACT_CONVERSION_LABEL=

# Browser-restricted key for the interactive contact-page map.
# Restrict it to Maps JavaScript API and approved site referrers in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me
# Google Analytics 4 measurement ID (GT-*). Enable GA4 tracking in gtag.js.
NEXT_PUBLIC_GA_MEASUREMENT_ID=GT-K5QZZ3V5

# --- Command Center ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/r_complete_command_center?schema=public"
AUTH_SECRET="replace-with-a-random-32-character-secret"
AUTH_TRUST_HOST="true"
DEMO_ADMIN_EMAIL="replace-me@example.com"
# bcrypt hash of the Command Center password. The plaintext password is never
# stored anywhere. Generate the hash with:
#     npm run hash-password
# (hidden prompt; prints the value for both Vercel and .env.local).
# IMPORTANT: Next.js expands $ in .env files, so in .env.local every $ in the
# hash must be escaped as \$ (the script prints it that way). In Vercel's
# Environment Variables UI paste the raw hash, unescaped.
# Sign-in fails closed if this is missing or not a valid bcrypt hash.
# DEMO_ADMIN_PASSWORD (plaintext) is no longer read; delete it everywhere.
DEMO_ADMIN_PASSWORD_HASH="\$2b\$12\$replace-with-the-output-of-npm-run-hash-password"

# --- Command Center integration sync (daily Vercel cron -> /api/integrations/sync) ---
# Read by the adapters in services/integrations/ (see each adapter.ts for the
# full list, including the per-resource TEKMETRIC_*_URL variables).
# Optional separate secret for manual/external callers of /api/integrations/sync.
# Vercel Cron itself authenticates with CRON_SECRET.
# INTEGRATION_SYNC_SECRET=replace-me
# TEKMETRIC_API_TOKEN=replace-me
# TEKMETRIC_CUSTOMERS_URL=replace-me
# RINGCENTRAL_ACCESS_TOKEN=replace-me
# RINGCENTRAL_SERVER_URL=replace-me
# QUICKBOOKS_ACCESS_TOKEN=replace-me
# QUICKBOOKS_REALM_ID=replace-me
# QUICKBOOKS_API_BASE_URL=replace-me
# GMAIL_ACCESS_TOKEN=replace-me
# GOOGLE_CALENDAR_ACCESS_TOKEN=replace-me
# GOOGLE_CALENDAR_ID=replace-me
